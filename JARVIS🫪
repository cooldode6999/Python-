import pyttsx3
import speech_recognition as sr
import datetime
import wikipedia
import webbrowser
import os
import cv2
import psutil
import pyautogui
import time

# --- INITIALIZE TEXT TO SPEECH ---
# pyttsx3 is a fully offline text-to-speech engine
engine = pyttsx3.init('sapi5') # 'sapi5' uses built-in Windows voices. Mac users can remove 'sapi5'
voices = engine.getProperty('voices')
# 0 is typically a Male voice (Jarvis), 1 is Female (Friday)
engine.setProperty('voice', voices[0].id) 
engine.setProperty('rate', 170) # Speed of speech

def speak(audio):
    """Speaks the given text out loud."""
    print(f"J.A.R.V.I.S: {audio}")
    engine.say(audio)
    engine.runAndWait()

def wish_me():
    """Greets based on the current local time."""
    hour = int(datetime.datetime.now().hour)
    if 0 <= hour < 12:
        speak("Good Morning, Sir!")
    elif 12 <= hour < 18:
        speak("Good Afternoon, Sir!")
    else:
        speak("Good Evening, Sir!")
    
    speak("System is online. Initiating security protocol.")

def detect_face():
    """Uses the webcam to scan for a face before granting full access."""
    speak("Activating camera for security scan. Please look at the lens.")
    
    # Load the pre-trained face detection algorithm built into OpenCV
    face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')
    cap = cv2.VideoCapture(0) # 0 is the default webcam
    
    start_time = time.time()
    authorized = False
    
    while True:
        ret, frame = cap.read()
        if not ret:
            break
            
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face_cascade.detectMultiScale(gray, 1.3, 5)
        
        # If at least one face is detected
        if len(faces) > 0:
            authorized = True
            for (x, y, w, h) in faces:
                cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
            cv2.imshow('J.A.R.V.I.S Security Scan', frame)
            cv2.waitKey(1500) # Keep the green box on screen for 1.5 seconds
            break
            
        cv2.imshow('J.A.R.V.I.S Security Scan', frame)
        
        # Timeout if no face is found after 10 seconds
        if time.time() - start_time > 10:
            break
            
        # Press 'q' to bypass manually
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
    
    if authorized:
        speak("Identity confirmed. Access granted. How can I help you today?")
        return True
    else:
        speak("No authorized face detected. Locking down critical systems.")
        return False

def take_command():
    """Listens to the microphone and converts speech to text."""
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("\n[Listening...]")
        r.pause_threshold = 1
        r.energy_threshold = 300 
        audio = r.listen(source)

    try:
        print("[Processing...]")
        # Uses Google's speech recognition API
        query = r.recognize_google(audio, language='en-in')
        print(f"You: {query}\n")
    except Exception:
        print("Say that again please...")
        return "None"
    
    return query.lower()

def get_system_stats():
    """Reads device hardware telemetry."""
    cpu = psutil.cpu_percent()
    battery = psutil.sensors_battery()
    
    speak(f"CPU usage is currently at {cpu} percent.")
    
    if battery:
        speak(f"Battery is at {battery.percent} percent.")
        if battery.power_plugged:
            speak("The system is connected to external power.")
        else:
            speak("We are currently running on battery power.")

if __name__ == "__main__":
    wish_me()
    
    # 1. BIOMETRIC SECURITY LOOP
    # The assistant will not listen to commands until it sees a face
    access = detect_face()
    
    if access:
        while True:
            query = take_command()

            # 2. INTERNET DATA CAPTURE
            if 'wikipedia' in query or 'who is' in query or 'what is' in query:
                speak('Searching the global database...')
                query = query.replace("wikipedia", "").replace("who is", "").replace("what is", "")
                try:
                    # Fetches a 2-sentence summary directly from Wikipedia
                    results = wikipedia.summary(query, sentences=2)
                    speak("According to Wikipedia:")
                    speak(results)
                except wikipedia.exceptions.DisambiguationError:
                    speak("There are too many results for that query, sir. Please be more specific.")
                except Exception:
                    speak("I couldn't find any verified information on that.")

            # 3. APPLICATION AUTOMATION
            elif 'open youtube' in query:
                speak("Opening YouTube.")
                webbrowser.open("https://youtube.com")

            elif 'open google' in query:
                speak("Opening Google.")
                webbrowser.open("https://google.com")

            # 4. SYSTEM DATE & TIME
            elif 'time' in query:
                strTime = datetime.datetime.now().strftime("%H:%M:%S")
                speak(f"Sir, the time is {strTime}")
                
            elif 'date' in query:
                strDate = datetime.datetime.now().strftime("%B %d, %Y")
                speak(f"Today is {strDate}")

            # 5. HARDWARE CONTROL & TELEMETRY
            elif 'system status' in query or 'battery' in query:
                get_system_stats()
                
            elif 'take screenshot' in query or 'capture screen' in query:
                speak("Taking screenshot.")
                img = pyautogui.screenshot()
                img.save("jarvis_screenshot.png")
                speak("Screenshot saved to the local directory.")

            # 6. CONVERSATIONAL LOGIC
            elif 'how are you' in query:
                speak("I am functioning at optimal capacity, sir.")

            elif 'who created you' in query:
                speak("I was created through advanced Python scripting.")

            # 7. SHUTDOWN PROTOCOL
            elif 'shut down' in query or 'go to sleep' in query or 'exit' in query:
                speak("Powering down systems. Goodbye, sir.")
                break
